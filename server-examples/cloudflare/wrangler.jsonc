{
    "name": "chat",
    "compatibility_date": "2026-11-13",
    "main": "index.js",
    "durable_objects": {
        "bindings": [
            {
                "name": "DURABLE_EXAMPLE",
                "class_name": "DurableExample"
            }
        ]
    },
    "exports": {
        "DurableExample": {
            "type": "durable-object",
            "storage": "sqlite"
        }
    },
    "observability": {
        "enabled": true
    }
}
